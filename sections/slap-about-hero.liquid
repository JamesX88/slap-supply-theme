{{ 'slap-supply-pressroom.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<!-- About Hero -->
<div class="slap-about-hero color-{{ section.settings.color_scheme }}">
  <div class="slap-about-hero__bg">
    {%- if section.settings.background_image != blank -%}
      {{ section.settings.background_image | image_url: width: 1920 | image_tag: class: 'slap-about-hero__bg-image', sizes: '100vw', widths: '800, 1200, 1600, 1920', loading: 'eager' }}
    {%- else -%}
      <img class="slap-about-hero__bg-image" src="{{ 'about-hero-bg.jpg' | asset_url }}" alt="Industrial workshop background" loading="eager" sizes="100vw">
    {%- endif -%}
    <div class="slap-about-hero__bg-overlay"></div>
    <div class="slap-about-hero__grid-overlay"></div>
  </div>
  <div class="page-width section-{{ section.id }}-padding">
    <div class="slap-about-hero__content">
      <div class="slap-about-hero__label slap-label">{{ section.settings.label_text }}</div>
      <h1 class="slap-about-hero__heading">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="slap-about-hero__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="slap-about-hero__cta slap-btn slap-btn--primary">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
  <div class="section-divider-caution"></div>
</div>

<style>
  .slap-about-hero {
    background-color: var(--slap-black);
    color: var(--slap-white);
    position: relative;
    overflow: hidden;
    min-height: 65vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .slap-about-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .slap-about-hero__bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.4;
    filter: saturate(0.6) contrast(1.1);
  }

  .slap-about-hero__bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(0, 0, 0, 0.88) 0%,
      rgba(0, 0, 0, 0.6) 40%,
      rgba(0, 0, 0, 0.45) 60%,
      rgba(57, 255, 20, 0.08) 100%
    );
    z-index: 1;
  }

  .slap-about-hero__grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(57, 255, 20, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(57, 255, 20, 0.06) 1px, transparent 1px);
    background-size: 40px 40px;
    z-index: 2;
  }

  .slap-about-hero__content {
    position: relative;
    z-index: 3;
    max-width: 800px;
  }

  .slap-about-hero__label {
    margin-bottom: 1.5rem;
  }

  .slap-about-hero__heading,
  h1.slap-about-hero__heading {
    font-family: 'Oswald', sans-serif !important;
    font-size: clamp(6rem, 16vw, 14rem) !important;
    font-weight: 900 !important;
    text-transform: uppercase;
    line-height: 0.88 !important;
    margin: 0 0 2rem;
    color: var(--slap-white);
    text-shadow: 3px 3px 12px rgba(0, 0, 0, 0.6);
    letter-spacing: -3px;
  }

  .slap-about-hero__heading em,
  .slap-about-hero__heading i {
    color: var(--slap-neon-green);
    font-style: normal;
    -webkit-text-stroke: 1px var(--slap-white);
  }

  .slap-about-hero__dot {
    color: #39FF14 !important;
    font-size: inherit;
    font-weight: inherit;
  }

  .slap-about-hero__subheading {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2rem !important;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.65 !important;
    max-width: 700px;
    margin: 0 0 2.5rem;
    text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.4);
  }

  .slap-about-hero__cta {
    display: inline-block;
    font-family: 'Oswald', sans-serif !important;
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 1rem 2.5rem;
    background: var(--slap-neon-green);
    color: var(--slap-black);
    border: 3px solid var(--slap-black);
    box-shadow: 4px 4px 0 rgba(255,255,255,0.3);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .slap-about-hero__cta:hover {
    background: var(--slap-white);
    color: var(--slap-black);
    box-shadow: 6px 6px 0 var(--slap-neon-green);
    transform: translate(-2px, -2px);
  }

  @media screen and (max-width: 749px) {
    .slap-about-hero {
      min-height: 50vh;
    }
    .slap-about-hero__heading,
    h1.slap-about-hero__heading {
      font-size: clamp(3rem, 15vw, 4rem) !important;
      letter-spacing: -2px;
    }
    .slap-about-hero__subheading {
      font-size: 1.35rem !important;
    }
  }
</style>

{% schema %}
{
  "name": "SLAP About Hero",
  "tag": "section",
  "class": "section slap-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "label_text",
      "default": "ABOUT US",
      "label": "Section Label"
    },
    {
      "type": "richtext",
      "id": "heading",
      "default": "<p>WE ARE<br><em>SLAP SUPPLY</em></p>",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "default": "Born in the press room. Built for brands that refuse to blend in. We're a custom sticker company that believes every surface is a canvas.",
      "label": "Subheading"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "SHOP NOW",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "SLAP About Hero"
    }
  ]
}
{% endschema %}
