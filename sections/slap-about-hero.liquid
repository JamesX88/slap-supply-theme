{{ 'slap-supply-pressroom.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<!-- About Hero -->
<div class="slap-about-hero color-{{ section.settings.color_scheme }}">
  <div class="slap-about-hero__bg">
    <div class="slap-about-hero__grid-overlay"></div>
  </div>
  <div class="page-width section-{{ section.id }}-padding">
    <div class="slap-about-hero__content">
      <div class="slap-about-hero__label slap-label">{{ section.settings.label_text }}</div>
      <h1 class="slap-about-hero__heading">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="slap-about-hero__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  </div>
  <div class="section-divider-caution"></div>
</div>

<style>
  .slap-about-hero {
    background-color: var(--slap-black);
    color: var(--slap-white);
    position: relative;
    overflow: hidden;
    min-height: 50vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .slap-about-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .slap-about-hero__grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(57, 255, 20, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(57, 255, 20, 0.05) 1px, transparent 1px);
    background-size: 40px 40px;
  }

  .slap-about-hero__content {
    position: relative;
    z-index: 1;
    max-width: 800px;
  }

  .slap-about-hero__label {
    margin-bottom: 1.5rem;
  }

  .slap-about-hero__heading {
    font-family: 'Oswald', sans-serif !important;
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 0.95;
    margin: 0 0 1.5rem;
    color: var(--slap-white);
  }

  .slap-about-hero__heading em,
  .slap-about-hero__heading i {
    color: var(--slap-neon-green);
    font-style: normal;
  }

  .slap-about-hero__subheading {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
    max-width: 600px;
    margin: 0;
  }
</style>

{% schema %}
{
  "name": "SLAP About Hero",
  "tag": "section",
  "class": "section slap-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "label_text",
      "default": "ABOUT US",
      "label": "Section Label"
    },
    {
      "type": "richtext",
      "id": "heading",
      "default": "<p>WE ARE<br><em>SLAP SUPPLY</em></p>",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "default": "Born in the press room. Built for brands that refuse to blend in. We're a custom sticker company that believes every surface is a canvas.",
      "label": "Subheading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "SLAP About Hero"
    }
  ]
}
{% endschema %}
