{% comment %}
  Hero Section V2 — Pixel-Perfect with Full Customization
  Uses CSS variables for better Shopify compatibility
{% endcomment %}

<style>
  #slap-hero-{{ section.id }} {
    --hero-container-width: {{ section.settings.container_width }}px;
    --hero-padding-top: {{ section.settings.padding_top }}px;
    --hero-padding-bottom: {{ section.settings.padding_bottom }}px;
    --hero-grid-gap: {{ section.settings.grid_gap }}px;
    --hero-bg-opacity: {{ section.settings.bg_opacity | divided_by: 100.0 }};
    --hero-bg-brightness: {{ section.settings.bg_brightness }}%;
    --hero-label-color: {{ section.settings.label_color }};
    --hero-label-font-size: {{ section.settings.label_font_size }}px;
    --hero-label-spacing: {{ section.settings.label_letter_spacing }};
    --hero-label-line-width: {{ section.settings.label_line_width }}px;
    --hero-label-margin: {{ section.settings.label_margin_bottom }}px;
    --hero-headline-color: {{ section.settings.headline_color }};
    --hero-headline-size: {{ section.settings.headline_font_size }}px;
    --hero-headline-margin: {{ section.settings.headline_margin_bottom }}px;
    --hero-accent-color: {{ section.settings.accent_color }};
    --hero-stroke-width: {{ section.settings.text_stroke_width }}px;
    --hero-stroke-color: {{ section.settings.text_stroke_color }};
    --hero-subtext-color: {{ section.settings.subtext_color }};
    --hero-subtext-size: {{ section.settings.subtext_font_size }}px;
    --hero-subtext-rotation: {{ section.settings.subtext_rotation }}deg;
    --hero-subtext-margin: {{ section.settings.subtext_margin_bottom }}px;
    --hero-cta-gap: {{ section.settings.cta_gap }}px;
    --hero-cta-padding-y: {{ section.settings.cta_padding_y }}px;
    --hero-cta-padding-x: {{ section.settings.cta_padding_x }}px;
    --hero-cta-font-size: {{ section.settings.cta_font_size }}px;
    --hero-primary-bg: {{ section.settings.primary_cta_bg }};
    --hero-primary-color: {{ section.settings.primary_cta_color }};
    --hero-primary-border: {{ section.settings.primary_cta_border }};
    --hero-secondary-bg: {{ section.settings.secondary_cta_bg }};
    --hero-secondary-color: {{ section.settings.secondary_cta_color }};
    --hero-secondary-border: {{ section.settings.secondary_cta_border }};
    --hero-collage-width: {{ section.settings.collage_max_width }}px;
  }
</style>

<section id="slap-hero-{{ section.id }}" class="slap-hero-v2" data-section-id="{{ section.id }}">
  <div class="slap-hero-v2__wrapper">
    {%- comment -%} Background Image {%- endcomment -%}
    {%- if section.settings.hero_image != blank -%}
    <div class="slap-hero-v2__bg">
      {{ section.settings.hero_image | image_url: width: 1920 | image_tag: loading: 'eager', class: 'slap-hero-v2__bg-img' }}
      <div class="slap-hero-v2__bg-overlay"></div>
    </div>
    {%- endif -%}

    {%- comment -%} Content Grid {%- endcomment -%}
    <div class="slap-hero-v2__content">
      <div class="slap-hero-v2__text">
        {%- comment -%} Station Label {%- endcomment -%}
        {%- if section.settings.show_station_label -%}
        <div class="slap-hero-v2__label">
          <span class="slap-hero-v2__label-line"></span>
          <span class="slap-hero-v2__label-text">{{ section.settings.station_label }}</span>
        </div>
        {%- endif -%}

        {%- comment -%} Main Headline with Animated Typing {%- endcomment -%}
        <h1 class="slap-hero-v2__headline">
          {{ section.settings.headline_part1 }} <span class="slap-hero-v2__typed" data-words='{{ section.settings.typed_words }}'></span>{{ section.settings.headline_punctuation }}<br>
          {{ section.settings.headline_part2 }} <span class="slap-hero-v2__highlight">{{ section.settings.headline_part3 }}</span>
        </h1>

        {%- comment -%} Subtext {%- endcomment -%}
        {%- if section.settings.subtext != blank -%}
        <p class="slap-hero-v2__subtext">{{ section.settings.subtext }}</p>
        {%- endif -%}

        {%- comment -%} CTAs {%- endcomment -%}
        <div class="slap-hero-v2__ctas">
          {%- if section.settings.primary_cta_text != blank -%}
          <a href="{{ section.settings.primary_cta_link }}" class="slap-hero-v2__cta slap-hero-v2__cta--primary">
            {{ section.settings.primary_cta_text }}
          </a>
          {%- endif -%}
          {%- if section.settings.secondary_cta_text != blank -%}
          <a href="{{ section.settings.secondary_cta_link }}" class="slap-hero-v2__cta slap-hero-v2__cta--secondary">
            {{ section.settings.secondary_cta_text }}
          </a>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Right Side Image {%- endcomment -%}
      <div class="slap-hero-v2__image">
        {%- if section.settings.collage_image != blank -%}
          {{ section.settings.collage_image | image_url: width: 800 | image_tag: loading: 'eager', class: 'slap-hero-v2__collage' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
(function() {
  function initHeroTyping() {
    const typedElement = document.querySelector('#slap-hero-{{ section.id }} .slap-hero-v2__typed');
    if (!typedElement) return;

    const wordsData = typedElement.getAttribute('data-words');
    if (!wordsData) return;

    let words;
    try {
      words = JSON.parse(wordsData);
    } catch (e) {
      return;
    }

    let currentWordIndex = 0;
    let currentText = '';
    let isDeleting = false;

    function type() {
      const currentWord = words[currentWordIndex];

      if (isDeleting) {
        currentText = currentWord.substring(0, currentText.length - 1);
      } else {
        currentText = currentWord.substring(0, currentText.length + 1);
      }

      typedElement.textContent = currentText;

      let typeSpeed = isDeleting ? 50 : 100;

      if (!isDeleting && currentText === currentWord) {
        typeSpeed = 2000;
        isDeleting = true;
      } else if (isDeleting && currentText === '') {
        isDeleting = false;
        currentWordIndex = (currentWordIndex + 1) % words.length;
        typeSpeed = 500;
      }

      setTimeout(type, typeSpeed);
    }

    type();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroTyping);
  } else {
    initHeroTyping();
  }
})();
</script>

