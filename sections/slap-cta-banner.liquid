{{ 'slap-supply-pressroom.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="slap-cta-v2">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="slap-cta-v2__inner">
      <div class="slap-cta-v2__content">
        <h3 class="slap-cta-v2__heading">
          READY TO <span class="slap-cta-v2__heading-green">SLAP</span>?
        </h3>
        <p class="slap-cta-v2__description">
          {{ section.settings.description }}
        </p>
      </div>
      <div class="slap-cta-v2__action">
        {%- if section.settings.button_label_1 != blank -%}
          <a href="{{ section.settings.button_link_1 }}" class="slap-cta-v2__btn">
            {{ section.settings.button_label_1 | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<style>
  .slap-cta-v2 {
    background-color: #1a1a1a;
    color: #fff;
    position: relative;
  }

  .slap-cta-v2__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .slap-cta-v2__content {
    flex: 1;
    min-width: 280px;
  }

  .slap-cta-v2__heading {
    font-family: 'Oswald', sans-serif !important;
    font-size: 48px;
    font-weight: 900;
    text-transform: uppercase;
    line-height: 48px;
    letter-spacing: -1.2px;
    margin: 0 0 1rem;
    color: #fff;
  }

  .slap-cta-v2__heading-green {
    color: #39FF14;
    font-style: italic;
  }

  .slap-cta-v2__description {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 16px;
    color: #a3a3a3;
    line-height: 24px;
    max-width: 500px;
    margin: 0;
  }

  .slap-cta-v2__action {
    flex-shrink: 0;
  }

  .slap-cta-v2__btn {
    display: inline-block;
    padding: 20px 40px;
    font-family: 'Oswald', sans-serif;
    font-size: 18px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.9px;
    text-decoration: none;
    background-color: #39FF14;
    color: #000;
    border: 2px solid #000;
    border-radius: 0;
    cursor: pointer;
    transition: all 0.15s ease;
    position: relative;
    box-shadow: none;
  }

  .slap-cta-v2__btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 rgba(57, 255, 20, 0.4);
    text-decoration: none;
    color: #000;
  }

  @media screen and (max-width: 749px) {
    .slap-cta-v2__inner {
      flex-direction: column;
      text-align: center;
      align-items: center;
    }

    .slap-cta-v2__heading {
      font-size: 36px;
      line-height: 36px;
    }

    .slap-cta-v2__description {
      max-width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "SLAP CTA Banner",
  "tag": "section",
  "class": "section slap-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "label_text",
      "default": "",
      "label": "Section Label"
    },
    {
      "type": "richtext",
      "id": "heading",
      "default": "<p>READY TO <em>SLAP</em>?</p>",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "description",
      "default": "Upload your design, configure your order, and get a free instant proof. No account required.",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "default": "START YOUR ORDER",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "default": "",
      "label": "Secondary Button Label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary Button Link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "number",
          "default": "10K+",
          "label": "Number/Value"
        },
        {
          "type": "text",
          "id": "label",
          "default": "Orders Shipped",
          "label": "Label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SLAP CTA Banner"
    }
  ]
}
{% endschema %}
