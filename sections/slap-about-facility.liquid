{{ 'slap-supply-pressroom.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="slap-about-facility color-{{ section.settings.color_scheme }}">
  <div class="page-width section-{{ section.id }}-padding">
    <!-- Facility Header -->
    <div class="slap-about-facility__header">
      <div class="slap-about-facility__label">{{ section.settings.label_text }}</div>
      <h2 class="slap-about-facility__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.description != blank -%}
        <p class="slap-about-facility__desc">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    <!-- Image Gallery Row -->
    <div class="slap-about-facility__gallery">
      {%- if section.settings.image_1 != blank -%}
        <div class="slap-about-facility__gallery-item slap-about-facility__gallery-item--large">
          {{ section.settings.image_1 | image_url: width: 900 | image_tag: class: 'slap-about-facility__gallery-img', sizes: '(min-width: 750px) 55vw, 100vw', widths: '400, 600, 900', loading: 'lazy' }}
        </div>
      {%- else -%}
        <div class="slap-about-facility__gallery-item slap-about-facility__gallery-item--large">
          <img src="{{ 'about-facility.jpg' | asset_url }}" alt="SLAP Supply Printing Facility" class="slap-about-facility__gallery-img" loading="lazy">
        </div>
      {%- endif -%}
      <div class="slap-about-facility__gallery-stack">
        {%- if section.settings.image_2 != blank -%}
          <div class="slap-about-facility__gallery-item">
            {{ section.settings.image_2 | image_url: width: 600 | image_tag: class: 'slap-about-facility__gallery-img', sizes: '(min-width: 750px) 35vw, 100vw', widths: '300, 450, 600', loading: 'lazy' }}
          </div>
        {%- else -%}
          <div class="slap-about-facility__gallery-item">
            <img src="{{ 'about-team.jpg' | asset_url }}" alt="SLAP Supply Team" class="slap-about-facility__gallery-img" loading="lazy">
          </div>
        {%- endif -%}
        {%- if section.settings.image_3 != blank -%}
          <div class="slap-about-facility__gallery-item">
            {{ section.settings.image_3 | image_url: width: 600 | image_tag: class: 'slap-about-facility__gallery-img', sizes: '(min-width: 750px) 35vw, 100vw', widths: '300, 450, 600', loading: 'lazy' }}
          </div>
        {%- else -%}
          <div class="slap-about-facility__gallery-item">
            <img src="{{ 'about-stickers.jpg' | asset_url }}" alt="Custom Die-Cut Stickers" class="slap-about-facility__gallery-img" loading="lazy">
          </div>
        {%- endif -%}
      </div>
    </div>

    <!-- Stats Row -->
    {%- assign stats = section.blocks | where: 'type', 'stat' -%}
    {%- if stats.size > 0 -%}
      <div class="slap-about-facility__stats">
        {%- for block in stats -%}
          <div class="slap-about-facility__stat" {{ block.shopify_attributes }}>
            <div class="slap-about-facility__stat-number">{{ block.settings.number }}</div>
            <div class="slap-about-facility__stat-label">{{ block.settings.label }}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <!-- Team / Capabilities Grid -->
    {%- assign capabilities = section.blocks | where: 'type', 'capability' -%}
    {%- if capabilities.size > 0 -%}
      <div class="slap-about-facility__capabilities">
        <h3 class="slap-about-facility__cap-heading">{{ section.settings.capabilities_heading }}</h3>
        <div class="slap-about-facility__cap-grid">
          {%- for block in capabilities -%}
            <div class="slap-about-facility__cap-item" {{ block.shopify_attributes }}>
              <div class="slap-about-facility__cap-icon">{{ block.settings.icon }}</div>
              <h4 class="slap-about-facility__cap-title">{{ block.settings.title }}</h4>
              <p class="slap-about-facility__cap-text">{{ block.settings.text }}</p>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
  <div class="section-divider-caution"></div>
</div>

<style>
  .slap-about-facility {
    background-color: var(--slap-white);
  }

  .slap-about-facility__header {
    margin-bottom: 3rem;
    max-width: 700px;
  }

  .slap-about-facility__label {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #737373;
    margin-bottom: 0.8rem;
  }

  .slap-about-facility__heading {
    font-family: 'Oswald', sans-serif !important;
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }

  .slap-about-facility__desc {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.1rem;
    color: #737373;
    line-height: 1.65;
    margin: 0;
  }

  /* Gallery */
  .slap-about-facility__gallery {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .slap-about-facility__gallery-stack {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 1.5rem;
  }

  .slap-about-facility__gallery-item {
    overflow: hidden;
    border: 3px solid var(--slap-black);
    position: relative;
  }

  .slap-about-facility__gallery-item--large {
    min-height: 350px;
  }

  .slap-about-facility__gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .slap-about-facility__gallery-item:hover .slap-about-facility__gallery-img {
    transform: scale(1.03);
  }

  .slap-about-facility__gallery-item:hover {
    box-shadow: 5px 5px 0 var(--slap-neon-green);
  }

  /* Stats */
  .slap-about-facility__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0;
    margin-bottom: 3rem;
    border: 3px solid var(--slap-black);
  }

  .slap-about-facility__stat {
    padding: 2rem;
    text-align: center;
    border-right: 2px solid var(--slap-black);
    transition: all 0.2s ease;
  }

  .slap-about-facility__stat:last-child {
    border-right: none;
  }

  .slap-about-facility__stat:hover {
    background: var(--slap-black);
  }

  .slap-about-facility__stat:hover .slap-about-facility__stat-number {
    color: var(--slap-neon-green);
  }

  .slap-about-facility__stat:hover .slap-about-facility__stat-label {
    color: rgba(255, 255, 255, 0.7);
  }

  .slap-about-facility__stat-number {
    font-family: 'Oswald', sans-serif;
    font-size: 3rem;
    font-weight: 900;
    color: var(--slap-neon-green);
    line-height: 1;
    margin-bottom: 0.3rem;
    -webkit-text-stroke: 1px var(--slap-black);
    paint-order: stroke fill;
    transition: color 0.2s ease;
  }

  .slap-about-facility__stat-label {
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #737373;
    transition: color 0.2s ease;
  }

  /* Capabilities */
  .slap-about-facility__capabilities {
    padding-top: 3rem;
    border-top: 3px solid var(--slap-black);
  }

  .slap-about-facility__cap-heading {
    font-family: 'Oswald', sans-serif !important;
    font-size: 1.5rem;
    font-weight: 900;
    text-transform: uppercase;
    margin: 0 0 2rem;
    letter-spacing: -0.02em;
  }

  .slap-about-facility__cap-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .slap-about-facility__cap-item {
    border: 2px solid var(--slap-black);
    padding: 2rem 1.5rem;
    background: var(--slap-white);
    transition: all 0.2s ease;
  }

  .slap-about-facility__cap-item:hover {
    box-shadow: 4px 4px 0 var(--slap-neon-green);
    transform: translate(-2px, -2px);
  }

  .slap-about-facility__cap-icon {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .slap-about-facility__cap-title {
    font-family: 'Oswald', sans-serif !important;
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    margin: 0 0 0.5rem;
    letter-spacing: 0.02em;
  }

  .slap-about-facility__cap-text {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.9rem;
    color: #737373;
    line-height: 1.5;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .slap-about-facility__cap-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .slap-about-facility__gallery {
      grid-template-columns: 1fr;
    }

    .slap-about-facility__gallery-item--large {
      min-height: 250px;
    }

    .slap-about-facility__gallery-stack {
      grid-template-columns: 1fr 1fr;
    }

    .slap-about-facility__stats {
      grid-template-columns: repeat(2, 1fr);
    }

    .slap-about-facility__stat {
      border-right: none;
      border-bottom: 2px solid var(--slap-black);
    }

    .slap-about-facility__stat:nth-child(odd) {
      border-right: 2px solid var(--slap-black);
    }

    .slap-about-facility__stat:last-child,
    .slap-about-facility__stat:nth-last-child(2):nth-child(odd) + .slap-about-facility__stat {
      border-bottom: none;
    }

    .slap-about-facility__cap-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "SLAP Facility & Team",
  "tag": "section",
  "class": "section slap-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "label_text",
      "default": "THE PRESS ROOM",
      "label": "Section Label"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "OUR FACILITY",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "description",
      "default": "State-of-the-art printing equipment, quality control at every step, and a team that obsesses over the details. Every order gets the same attention — whether it's 50 stickers or 50,000.",
      "label": "Description"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Gallery Image 1 (Large)"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Gallery Image 2 (Top Right)"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Gallery Image 3 (Bottom Right)"
    },
    {
      "type": "text",
      "id": "capabilities_heading",
      "default": "OUR CAPABILITIES",
      "label": "Capabilities Heading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "number",
          "default": "10K+",
          "label": "Number"
        },
        {
          "type": "text",
          "id": "label",
          "default": "Orders Shipped",
          "label": "Label"
        }
      ]
    },
    {
      "type": "capability",
      "name": "Capability",
      "limit": 9,
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "default": "🖨️",
          "label": "Icon (emoji)"
        },
        {
          "type": "text",
          "id": "title",
          "default": "DIGITAL PRINTING",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "default": "High-resolution digital printing for vibrant, photo-quality results on any material.",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SLAP Facility & Team",
      "blocks": [
        {
          "type": "stat",
          "settings": { "number": "10K+", "label": "Orders Shipped" }
        },
        {
          "type": "stat",
          "settings": { "number": "500+", "label": "5-Star Reviews" }
        },
        {
          "type": "stat",
          "settings": { "number": "3 DAY", "label": "Avg. Turnaround" }
        },
        {
          "type": "stat",
          "settings": { "number": "50+", "label": "Materials" }
        },
        {
          "type": "capability",
          "settings": {
            "icon": "🖨️",
            "title": "DIGITAL PRINTING",
            "text": "High-resolution digital printing for vibrant, photo-quality results on any material."
          }
        },
        {
          "type": "capability",
          "settings": {
            "icon": "✂️",
            "title": "DIE CUTTING",
            "text": "Precision die-cut and kiss-cut capabilities for any shape or size you can imagine."
          }
        },
        {
          "type": "capability",
          "settings": {
            "icon": "🛡️",
            "title": "LAMINATION",
            "text": "UV-resistant, waterproof lamination options to protect your prints from the elements."
          }
        },
        {
          "type": "capability",
          "settings": {
            "icon": "📦",
            "title": "FULFILLMENT",
            "text": "In-house packaging and shipping. We handle the logistics so you can focus on your brand."
          }
        },
        {
          "type": "capability",
          "settings": {
            "icon": "🎨",
            "title": "DESIGN SERVICES",
            "text": "Need help with your artwork? Our design team can create or refine your vision."
          }
        },
        {
          "type": "capability",
          "settings": {
            "icon": "🔬",
            "title": "QUALITY CONTROL",
            "text": "Every order inspected before shipping. We don't let anything leave that isn't perfect."
          }
        }
      ]
    }
  ]
}
{% endschema %}
