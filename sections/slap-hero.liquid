{{ 'slap-supply-pressroom.css' | asset_url | stylesheet_tag }}

<div id="SlapHero-{{ section.id }}" class="slap-hero-v2">
  <div class="slap-hero-v2__inner page-width">
    <!-- Left Content -->
    <div class="slap-hero-v2__content">
      <div class="slap-hero-v2__station-label">STATION 01 — HERO</div>

      <h2 class="slap-hero-v2__heading">
        PRINT IT.<br>
        <span class="slap-hero-v2__heading-stroke">STICK IT.</span><br>
        OWN IT.
      </h2>

      <p class="slap-hero-v2__subheading">
        Custom stickers, labels, and prints built to your exact specifications. Industrial-grade quality. No minimum orders.
      </p>

      <div class="slap-hero-v2__buttons">
        {%- if section.settings.button_label_1 != blank -%}
          <a href="{{ section.settings.button_link_1 }}" class="slap-hero-v2__btn slap-hero-v2__btn--primary">
            {{ section.settings.button_label_1 | escape }} <span class="slap-hero-v2__btn-arrow">→</span>
          </a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a href="{{ section.settings.button_link_2 }}" class="slap-hero-v2__btn slap-hero-v2__btn--secondary">
            {{ section.settings.button_label_2 | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>

    <!-- Right Image -->
    <div class="slap-hero-v2__image-wrapper">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            class: 'slap-hero-v2__image',
            sizes: '(min-width: 750px) 50vw, 100vw',
            widths: '375, 750, 1100, 1200',
            fetchpriority: 'high'
        }}
      {%- else -%}
        <div class="slap-hero-v2__placeholder-image">
          <img src="{{ 'about-stickers.jpg' | asset_url }}" alt="Custom stickers and prints by SLAP Supply" class="slap-hero-v2__image" loading="eager">
        </div>
      {%- endif -%}
      <div class="slap-hero-v2__image-caption">
        <span>WORKSHOP FLOOR — 2026</span>
      </div>
    </div>
  </div>
</div>

<style>
  .slap-hero-v2 {
    background-color: #FFFFFF;
    padding: 0;
    overflow: hidden;
  }

  .slap-hero-v2__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    padding-top: 64px;
    padding-bottom: 64px;
    min-height: 500px;
  }

  .slap-hero-v2__station-label {
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #737373;
    margin-bottom: 1.5rem;
  }

  .slap-hero-v2__heading {
    font-family: 'Oswald', sans-serif !important;
    font-size: 96px !important;
    font-weight: 900 !important;
    text-transform: uppercase;
    line-height: 0.9 !important;
    color: #1a1a1a;
    margin: 0 0 1.5rem;
    letter-spacing: -4.8px !important;
  }

  .slap-hero-v2__heading-stroke {
    color: #39FF14;
    -webkit-text-stroke: 3px #1a1a1a;
    text-stroke: 3px #1a1a1a;
    paint-order: stroke fill;
    letter-spacing: 2px;
  }

  .slap-hero-v2__subheading {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 18px;
    color: #555;
    max-width: 400px;
    line-height: 29.25px;
    margin: 0 0 2rem;
    font-weight: 400;
    text-transform: none;
  }

  .slap-hero-v2__buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .slap-hero-v2__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 16px 32px;
    font-family: 'Oswald', sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.7px;
    text-decoration: none;
    border: 2px solid #000;
    border-radius: 0;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .slap-hero-v2__btn--primary {
    background-color: #39FF14;
    color: #000;
    box-shadow: none;
  }

  .slap-hero-v2__btn--primary:hover {
    box-shadow: 4px 4px 0 #000;
    transform: translate(-2px, -2px);
    color: #000;
    text-decoration: none;
  }

  .slap-hero-v2__btn--secondary {
    background-color: transparent;
    color: #1a1a1a;
    border-style: dashed;
    box-shadow: none;
  }

  .slap-hero-v2__btn--secondary:hover {
    background-color: #1a1a1a;
    color: #39FF14;
    border-style: solid;
    text-decoration: none;
  }

  .slap-hero-v2__btn-arrow {
    font-size: 1.1em;
  }

  .slap-hero-v2__image-wrapper {
    position: relative;
    border: 2px solid #1a1a1a;
    overflow: hidden;
    background: #f5f5f0;
    box-shadow: none;
  }

  .slap-hero-v2__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    min-height: 400px;
  }

  .slap-hero-v2__placeholder-image {
    width: 100%;
    height: 100%;
  }

  .slap-hero-v2__image-caption {
    position: absolute;
    bottom: 16px;
    right: 16px;
    background: #fff;
    border: 1px solid #1a1a1a;
    padding: 6px 12px;
    font-family: 'Space Mono', monospace;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #1a1a1a;
    z-index: 2;
  }

  @media screen and (max-width: 749px) {
    .slap-hero-v2__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-top: 2rem;
      padding-bottom: 2rem;
    }

    .slap-hero-v2__heading {
      font-size: clamp(3.5rem, 14vw, 5.5rem) !important;
      line-height: 0.9 !important;
      letter-spacing: -3px !important;
    }

    .slap-hero-v2__buttons {
      flex-direction: column;
    }

    .slap-hero-v2__btn {
      text-align: center;
      justify-content: center;
    }

    .slap-hero-v2__image {
      min-height: 250px;
    }
  }
</style>

{% schema %}
{
  "name": "SLAP Hero Banner",
  "tag": "section",
  "class": "section slap-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image (right side)"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "default": "START CUSTOMIZING",
      "label": "Primary Button Label"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "default": "VIEW CATALOG",
      "label": "Secondary Button Label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary Button Link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "SLAP Hero Banner"
    }
  ]
}
{% endschema %}
