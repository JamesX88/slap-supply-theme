<product-info
  id="MainProduct-{{ section.id }}"
  class="spec-sheet-wrapper"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'slap-spec-sheet.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}

  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link id="ModelViewerStyle" rel="stylesheet" href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css" media="print" onload="this.media='all'">
    <link id="ModelViewerOverride" rel="stylesheet" href="{{ 'component-model-viewer-ui.css' | asset_url }}" media="print" onload="this.media='all'">
  {%- endif -%}

  {%- assign product_form_id = 'product-form-' | append: section.id -%}
  {%- assign current_variant = product.selected_or_first_available_variant -%}

  <!-- ============================================================
       SPEC SHEET LAYOUT: 50/50 Vertical Split
       ============================================================ -->
  <div class="spec-sheet">

    <!-- ========== LEFT PANEL: Sticky Image Gallery ========== -->
    <div class="spec-sheet__gallery">
      <div class="spec-sheet__gallery-inner">
        <div class="spec-sheet__main-image" id="SpecSheetMainImage-{{ section.id }}">
          {%- if product.compare_at_price > product.price -%}
            <span class="spec-sheet__badge">SALE</span>
          {%- endif -%}

          {%- for media in product.media -%}
            <img
              id="SpecSheetImage-{{ section.id }}-{{ forloop.index }}"
              src="{{ media | image_url: width: 1200 }}"
              alt="{{ media.alt | escape | default: product.title | escape }}"
              width="{{ media.width }}"
              height="{{ media.height }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              style="{% unless forloop.first %}display: none;{% endunless %} max-width: 100%; max-height: 100%; object-fit: contain;"
            >
          {%- endfor -%}

          {%- if product.media.size == 0 -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}

          {%- if product.media.size > 1 -%}
            <span class="spec-sheet__image-counter" id="SpecSheetCounter-{{ section.id }}">
              01 / {{ product.media.size | prepend: '00' | slice: -2, 2 }}
            </span>
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="spec-sheet__thumbnails" id="SpecSheetThumbs-{{ section.id }}">
            {%- for media in product.media -%}
              <button
                class="spec-sheet__thumb{% if forloop.first %} is-active{% endif %}"
                data-index="{{ forloop.index }}"
                data-section="{{ section.id }}"
                type="button"
                aria-label="Load image {{ forloop.index }}"
              >
                <img
                  src="{{ media | image_url: width: 200 }}"
                  alt="{{ media.alt | escape | default: product.title | escape }}"
                  width="80"
                  height="80"
                  loading="lazy"
                >
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    <!-- ========== RIGHT PANEL: Scrolling Specs ========== -->
    <div class="spec-sheet__details">

      <!-- CAUTION TAPE -->
      <div class="spec-sheet__caution-tape"></div>

      <!-- SPEC 01: Product Identity -->
      <div class="spec-section spec-sheet__header-section">
        <div class="spec-section__number">SPEC 01 — PRODUCT ID</div>

        {%- if product.vendor != blank -%}
          <div class="spec-sheet__vendor">{{ product.vendor }}</div>
        {%- endif -%}

        <h1 class="spec-sheet__title">{{ product.title | escape }}</h1>

        {%- if current_variant.sku != blank -%}
          <div class="spec-sheet__sku" id="Sku-{{ section.id }}">
            SKU: {{ current_variant.sku }}
          </div>
        {%- endif -%}

        <div class="spec-sheet__social-proof">
          <span class="spec-sheet__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          <span class="spec-sheet__rating-text">4.9/5</span>
          <span class="spec-sheet__rating-count">&bull; 2,400+ orders shipped</span>
        </div>
      </div>

      <!-- SPEC 02: Pricing -->
      <div class="spec-section spec-sheet__pricing-section">
        <div class="spec-section__number">SPEC 02 — PRICING</div>

        <div class="spec-sheet__price-row" id="price-{{ section.id }}">
          {%- if product.compare_at_price > product.price -%}
            <span class="spec-sheet__price-compare">{{ product.compare_at_price | money }}</span>
          {%- endif -%}
          <span class="spec-sheet__price-current">{{ product.price | money }}</span>
          {%- if product.compare_at_price > product.price -%}
            <span class="spec-sheet__price-badge">SALE</span>
          {%- endif -%}
        </div>

        {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
          <div class="spec-sheet__tax-info">
            {%- if cart.taxes_included -%}
              {{ 'products.product.taxes_included' | t }}
            {%- endif -%}
            {%- if shop.shipping_policy.body != blank -%}
              {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="spec-sheet__installment">
          {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
          {%- form 'product', product, id: product_form_installment_id, class: 'installment caption-large' -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
            {{ form | payment_terms }}
          {%- endform -%}
        </div>

        <div class="spec-sheet__urgency">
          <span class="spec-sheet__urgency-icon">&#9889;</span>
          <span>Order today &mdash; ships within 3-5 business days</span>
        </div>
      </div>

      <!-- CAUTION TAPE -->
      <div class="spec-sheet__caution-tape"></div>

      <!-- SPEC 03: Configuration (Variants) -->
      <div class="spec-section spec-sheet__config-section">
        <div class="spec-section__number">SPEC 03 — CONFIGURATION</div>

        {%- unless product.has_only_default_variant -%}
          <variant-selects
            id="variant-selects-{{ section.id }}"
            data-section="{{ section.id }}"
          >
            {%- for option in product.options_with_values -%}
              {%- liquid
                assign swatch_count = option.values | map: 'swatch' | compact | size
                assign picker_type = 'button'

                if swatch_count > 0
                  assign picker_type = 'swatch'
                endif
              -%}
              {%- if picker_type == 'swatch' -%}
                <fieldset class="js product-form__input product-form__input--swatch">
                  <legend class="form__label">
                    {{ option.name }}:
                    <span data-selected-value>{{ option.selected_value }}</span>
                  </legend>
                  {% render 'product-variant-options',
                    product: product,
                    option: option,
                    block: block,
                    picker_type: picker_type
                  %}
                </fieldset>
              {%- else -%}
                <fieldset class="js product-form__input product-form__input--pill">
                  <legend class="form__label">{{ option.name }}</legend>
                  {% render 'product-variant-options',
                    product: product,
                    option: option,
                    block: block,
                    picker_type: 'button'
                  %}
                </fieldset>
              {%- endif -%}
            {%- endfor -%}

            <script type="application/json" data-selected-variant>
              {{ product.selected_or_first_available_variant | json }}
            </script>
          </variant-selects>
        {%- endunless -%}
      </div>

      <!-- SPEC 04: Quantity + Add to Cart -->
      <div class="spec-section spec-sheet__cart-section">
        <div class="spec-section__number">SPEC 04 — ORDER</div>

        {% comment %} Quantity {% endcomment %}
        <label class="spec-sheet__qty-label" for="Quantity-{{ section.id }}">
          {{ 'products.product.quantity.label' | t }}
        </label>

        <div class="spec-sheet__quantity-row">
          <div>
            {% # theme-check-disable %}
            {%- assign cart_qty = cart | item_count_for_variant: product.selected_or_first_available_variant.id -%}
            {% # theme-check-enable %}
            <quantity-input class="quantity" data-url="{{ product.url }}" data-section="{{ section.id }}">
              <button class="quantity__button" name="minus" type="button">
                <span class="visually-hidden">{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}</span>
                <span class="svg-wrapper">{{ 'icon-minus.svg' | inline_asset_content }}</span>
              </button>
              <input
                class="quantity__input"
                type="number"
                name="quantity"
                id="Quantity-{{ section.id }}"
                data-cart-quantity="{{ cart_qty }}"
                data-min="{{ current_variant.quantity_rule.min }}"
                min="{{ current_variant.quantity_rule.min }}"
                {% if current_variant.quantity_rule.max != null %}
                  data-max="{{ current_variant.quantity_rule.max }}"
                  max="{{ current_variant.quantity_rule.max }}"
                {% endif %}
                step="{{ current_variant.quantity_rule.increment }}"
                value="{{ current_variant.quantity_rule.min }}"
                form="{{ product_form_id }}"
              >
              <button class="quantity__button" name="plus" type="button">
                <span class="visually-hidden">{{ 'products.product.quantity.increase' | t: product: product.title | escape }}</span>
                <span class="svg-wrapper">{{ 'icon-plus.svg' | inline_asset_content }}</span>
              </button>
            </quantity-input>
          </div>

          {% comment %} Add to Cart {% endcomment %}
          <div class="spec-sheet__add-to-cart">
            <product-form
              class="product-form"
              data-hide-errors="false"
              data-section-id="{{ section.id }}"
            >
              <div class="product-form__error-message-wrapper" role="alert" hidden>
                <span class="svg-wrapper">{{ 'icon-error.svg' | inline_asset_content }}</span>
                <span class="product-form__error-message"></span>
              </div>

              {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                <input
                  type="hidden"
                  name="id"
                  value="{{ current_variant.id }}"
                  {% if current_variant.available == false or current_variant == null %}disabled{% endif %}
                  class="product-variant-id"
                >
                <div class="product-form__buttons">
                  <button
                    id="ProductSubmitButton-{{ section.id }}"
                    type="submit"
                    name="add"
                    class="product-form__submit button button--full-width button--primary"
                    {% if current_variant.available == false or current_variant == null %}disabled{% endif %}
                  >
                    <span>
                      {%- if current_variant == null -%}
                        {{ 'products.product.unavailable' | t }}
                      {%- elsif current_variant.available == false -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- else -%}
                        ADD TO CART &rarr;
                      {%- endif -%}
                    </span>
                    {%- render 'loading-spinner' -%}
                  </button>
                </div>
              {%- endform -%}
            </product-form>
          </div>
        </div>

        {% comment %} Dynamic Checkout / Buy it Now {% endcomment %}
        <div class="spec-sheet__dynamic-checkout">
          {%- assign dynamic_form_id = 'product-form-dynamic-' | append: section.id -%}
          {%- form 'product', product, id: dynamic_form_id, class: 'form', novalidate: 'novalidate' -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" class="product-variant-id">
            {{ form | payment_button }}
          {%- endform -%}
        </div>
      </div>

      <!-- SPEC 05: Trust Signals -->
      <div class="spec-section spec-sheet__trust-section">
        <div class="spec-section__number">SPEC 05 — TRUST</div>

        <div class="spec-sheet__trust-grid">
          <div class="spec-sheet__trust-item">
            <span class="spec-sheet__trust-icon">&#128666;</span>
            <span>Free shipping $50+</span>
          </div>
          <div class="spec-sheet__trust-item">
            <span class="spec-sheet__trust-icon">&#9728;&#65039;</span>
            <span>Weatherproof & UV-resistant</span>
          </div>
          <div class="spec-sheet__trust-item">
            <span class="spec-sheet__trust-icon">&#127981;</span>
            <span>Made in-house, USA</span>
          </div>
          <div class="spec-sheet__trust-item">
            <span class="spec-sheet__trust-icon">&#128230;</span>
            <span>Bulk discounts available</span>
          </div>
        </div>

        <div class="spec-sheet__guarantee">
          <span class="spec-sheet__guarantee-icon">&#128737;&#65039;</span>
          <div>
            <div class="spec-sheet__guarantee-title">100% Satisfaction Guarantee</div>
            <div class="spec-sheet__guarantee-desc">Not happy with your order? We'll reprint or refund &mdash; no questions asked.</div>
          </div>
        </div>

        <div class="spec-sheet__payment">
          <span class="spec-sheet__payment-label">Secure checkout with</span>
          <span class="spec-sheet__payment-icon">VISA</span>
          <span class="spec-sheet__payment-icon">MC</span>
          <span class="spec-sheet__payment-icon">AMEX</span>
          <span class="spec-sheet__payment-icon">SHOP</span>
          <span class="spec-sheet__payment-icon">PYPL</span>
          <span class="spec-sheet__payment-icon">&#128274;</span>
        </div>
      </div>

      <!-- CAUTION TAPE -->
      <div class="spec-sheet__caution-tape"></div>

      <!-- SPEC 06: Description -->
      {%- if product.description != blank -%}
        <div class="spec-section spec-sheet__desc-section">
          <div class="spec-section__number">SPEC 06 — DESCRIPTION</div>
          <div class="spec-sheet__description rte">
            {{ product.description }}
          </div>
        </div>
      {%- endif -%}

      <!-- SPEC 07: Product Specs (Accordion) -->
      <div class="spec-section spec-sheet__specs-section">
        <div class="spec-section__number">SPEC 07 — SPECIFICATIONS</div>

        <div class="spec-sheet__accordion">
          {%- for block in section.blocks -%}
            {%- if block.type == 'collapsible_tab' -%}
              <details class="spec-sheet__accordion-item" id="Details-{{ block.id }}-{{ section.id }}" {{ block.shopify_attributes }}>
                <summary class="spec-sheet__accordion-summary">
                  <span class="spec-sheet__accordion-title">
                    <span class="spec-sheet__accordion-icon">
                      {% render 'icon-accordion', icon: block.settings.icon %}
                    </span>
                    {{ block.settings.heading | default: block.settings.page.title | escape }}
                  </span>
                  <svg class="spec-sheet__accordion-caret" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </summary>
                <div class="spec-sheet__accordion-content">
                  {{ block.settings.content }}
                  {{ block.settings.page.content }}
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <!-- CAUTION TAPE -->
      <div class="spec-sheet__caution-tape"></div>

      <!-- SPEC 08: Reviews -->
      <div class="spec-section spec-sheet__reviews-section">
        <div class="spec-section__number">SPEC 08 — REVIEWS</div>

        <div class="spec-sheet__reviews-header">
          <span class="spec-sheet__reviews-title">Customer Reviews</span>
          <span class="spec-sheet__reviews-avg">
            <span class="spec-sheet__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            <span>4.9 / 5.0</span>
          </span>
        </div>

        <div class="spec-sheet__review-card">
          <div class="spec-sheet__review-top">
            <span class="spec-sheet__review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            <span class="spec-sheet__review-verified">&#10003; Verified</span>
          </div>
          <div class="spec-sheet__review-text">
            "Ordered 500 die-cut stickers for our product launch and they came out PERFECT. Colors matched our Pantone specs exactly."
          </div>
          <div class="spec-sheet__review-author">— Marcus T.</div>
        </div>

        <div class="spec-sheet__review-card">
          <div class="spec-sheet__review-top">
            <span class="spec-sheet__review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            <span class="spec-sheet__review-verified">&#10003; Verified</span>
          </div>
          <div class="spec-sheet__review-text">
            "We switched to SLAP Supply for our candle labels 6 months ago and haven't looked back. Waterproof, heat-resistant, and the print quality is insane."
          </div>
          <div class="spec-sheet__review-author">— Jessica R.</div>
        </div>

        <div class="spec-sheet__review-card">
          <div class="spec-sheet__review-top">
            <span class="spec-sheet__review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            <span class="spec-sheet__review-verified">&#10003; Verified</span>
          </div>
          <div class="spec-sheet__review-text">
            "3-day turnaround is real. Needed a rush order of 1,000 holographic stickers for a trade show. Quality was flawless."
          </div>
          <div class="spec-sheet__review-author">— David K.</div>
        </div>
      </div>

      <!-- Share -->
      <div class="spec-section" style="padding-top: 0;">
        <div class="spec-sheet__share">
          <span class="spec-sheet__share-label">Share:</span>
          <button class="spec-sheet__share-btn" onclick="navigator.clipboard.writeText(window.location.href)" title="Copy link">&#128279;</button>
          <a class="spec-sheet__share-btn" href="https://twitter.com/intent/tweet?url={{ product.url | prepend: request.origin | url_encode }}&text={{ product.title | url_encode }}" target="_blank" rel="noopener" title="Share on Twitter">&#120143;</a>
          <a class="spec-sheet__share-btn" href="https://www.facebook.com/sharer/sharer.php?u={{ product.url | prepend: request.origin | url_encode }}" target="_blank" rel="noopener" title="Share on Facebook">f</a>
        </div>
      </div>

    </div><!-- /.spec-sheet__details -->
  </div><!-- /.spec-sheet -->

  <!-- Gallery Thumbnail JS -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var sectionId = '{{ section.id }}';
      var thumbContainer = document.getElementById('SpecSheetThumbs-' + sectionId);
      var mainImageContainer = document.getElementById('SpecSheetMainImage-' + sectionId);
      var counter = document.getElementById('SpecSheetCounter-' + sectionId);
      var totalImages = {{ product.media.size | default: 1 }};

      if (thumbContainer) {
        thumbContainer.addEventListener('click', function(e) {
          var thumb = e.target.closest('.spec-sheet__thumb');
          if (!thumb) return;

          var index = parseInt(thumb.getAttribute('data-index'));

          // Update active state
          thumbContainer.querySelectorAll('.spec-sheet__thumb').forEach(function(t) {
            t.classList.remove('is-active');
          });
          thumb.classList.add('is-active');

          // Show/hide images
          mainImageContainer.querySelectorAll('img[id^="SpecSheetImage"]').forEach(function(img) {
            img.style.display = 'none';
          });
          var targetImg = document.getElementById('SpecSheetImage-' + sectionId + '-' + index);
          if (targetImg) {
            targetImg.style.display = 'block';
          }

          // Update counter
          if (counter) {
            var indexStr = index < 10 ? '0' + index : '' + index;
            var totalStr = totalImages < 10 ? '0' + totalImages : '' + totalImages;
            counter.textContent = indexStr + ' / ' + totalStr;
          }
        });
      }
    });
  </script>

</product-info>

{% schema %}
{
  "name": "t:sections.main-product.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "text",
      "name": "t:sections.main-product.blocks.text.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Text block",
          "label": "t:sections.main-product.blocks.text.settings.text.label"
        },
        {
          "type": "select",
          "id": "text_style",
          "options": [
            { "value": "body", "label": "t:sections.main-product.blocks.text.settings.text_style.options__1.label" },
            { "value": "subtitle", "label": "t:sections.main-product.blocks.text.settings.text_style.options__2.label" },
            { "value": "uppercase", "label": "t:sections.main-product.blocks.text.settings.text_style.options__3.label" }
          ],
          "default": "body",
          "label": "t:sections.main-product.blocks.text.settings.text_style.label"
        }
      ]
    },
    {
      "type": "title",
      "name": "t:sections.main-product.blocks.title.name",
      "limit": 1
    },
    {
      "type": "price",
      "name": "t:sections.main-product.blocks.price.name",
      "limit": 1
    },
    {
      "type": "sku",
      "name": "t:sections.main-product.blocks.sku.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "text_style",
          "options": [
            { "value": "body", "label": "t:sections.main-product.blocks.text.settings.text_style.options__1.label" },
            { "value": "subtitle", "label": "t:sections.main-product.blocks.text.settings.text_style.options__2.label" },
            { "value": "uppercase", "label": "t:sections.main-product.blocks.text.settings.text_style.options__3.label" }
          ],
          "default": "body",
          "label": "t:sections.main-product.blocks.text.settings.text_style.label"
        }
      ]
    },
    {
      "type": "quantity_selector",
      "name": "t:sections.main-product.blocks.quantity_selector.name",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "t:sections.main-product.blocks.variant_picker.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_type",
          "options": [
            { "value": "dropdown", "label": "t:sections.main-product.blocks.variant_picker.settings.picker_type.options__1.label" },
            { "value": "button", "label": "t:sections.main-product.blocks.variant_picker.settings.picker_type.options__2.label" }
          ],
          "default": "button",
          "label": "t:sections.main-product.blocks.variant_picker.settings.picker_type.label"
        },
        {
          "type": "select",
          "id": "swatch_shape",
          "options": [
            { "value": "none", "label": "t:sections.main-product.blocks.variant_picker.settings.swatch_shape.options__1.label" },
            { "value": "circle", "label": "t:sections.main-product.blocks.variant_picker.settings.swatch_shape.options__2.label" },
