{{ 'slap-supply-pressroom.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="slap-reviews" id="SlapReviews-{{ section.id }}">
  <div class="page-width section-{{ section.id }}-padding">
    <!-- Section Header -->
    <div class="slap-reviews__header">
      {%- if section.settings.label_text != blank -%}
        <div class="slap-reviews__label">{{ section.settings.label_text }}</div>
      {%- endif -%}
      <h2 class="slap-reviews__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="slap-reviews__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}

      <!-- Aggregate Rating -->
      <div class="slap-reviews__aggregate">
        <div class="slap-reviews__stars-large">
          {%- for i in (1..5) -%}
            <span class="slap-reviews__star slap-reviews__star--filled">★</span>
          {%- endfor -%}
        </div>
        <span class="slap-reviews__rating-text">{{ section.settings.rating_text }}</span>
      </div>
    </div>

    <!-- Reviews Grid -->
    <div class="slap-reviews__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <div class="slap-reviews__card" {{ block.shopify_attributes }}>
            <div class="slap-reviews__card-inner">
              <!-- Stars -->
              <div class="slap-reviews__card-stars">
                {%- assign stars = block.settings.stars | default: 5 -%}
                {%- for i in (1..5) -%}
                  {%- if i <= stars -%}
                    <span class="slap-reviews__star slap-reviews__star--filled">★</span>
                  {%- else -%}
                    <span class="slap-reviews__star">★</span>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              <!-- Review Title -->
              {%- if block.settings.title != blank -%}
                <h4 class="slap-reviews__card-title">{{ block.settings.title }}</h4>
              {%- endif -%}

              <!-- Review Text -->
              <p class="slap-reviews__card-text">"{{ block.settings.text }}"</p>

              <!-- Reviewer Info -->
              <div class="slap-reviews__card-author">
                <div class="slap-reviews__card-avatar">
                  {{ block.settings.name | slice: 0 }}
                </div>
                <div class="slap-reviews__card-info">
                  <span class="slap-reviews__card-name">{{ block.settings.name }}</span>
                  {%- if block.settings.product != blank -%}
                    <span class="slap-reviews__card-product">{{ block.settings.product }}</span>
                  {%- endif -%}
                </div>
                {%- if block.settings.verified -%}
                  <span class="slap-reviews__card-verified">✓ VERIFIED</span>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .slap-reviews {
    background-color: #F5F5F0;
    position: relative;
    overflow: hidden;
  }

  .slap-reviews__header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .slap-reviews__label {
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #737373;
    margin-bottom: 1rem;
  }

  .slap-reviews__heading {
    font-family: 'Oswald', sans-serif !important;
    font-size: 48px;
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1;
    letter-spacing: -1.2px;
    color: #1a1a1a;
    margin: 0 0 0.75rem;
  }

  .slap-reviews__subheading {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 16px;
    color: #737373;
    max-width: 500px;
    margin: 0 auto 1.5rem;
    line-height: 1.5;
  }

  .slap-reviews__aggregate {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }

  .slap-reviews__stars-large {
    display: flex;
    gap: 2px;
  }

  .slap-reviews__star {
    font-size: 18px;
    color: #d4d4d4;
    line-height: 1;
  }

  .slap-reviews__star--filled {
    color: #39FF14;
  }

  .slap-reviews__rating-text {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #737373;
    text-transform: uppercase;
  }

  .slap-reviews__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .slap-reviews__card {
    background: #fff;
    border: 3px solid #1a1a1a;
    border-radius: 0;
    transition: all 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .slap-reviews__card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 #39FF14;
  }

  .slap-reviews__card-inner {
    padding: 1.75rem;
  }

  .slap-reviews__card-stars {
    display: flex;
    gap: 2px;
    margin-bottom: 1rem;
  }

  .slap-reviews__card-title {
    font-family: 'Oswald', sans-serif !important;
    font-size: 18px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.3px;
    color: #1a1a1a;
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }

  .slap-reviews__card-text {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    color: #555;
    line-height: 1.6;
    margin: 0 0 1.25rem;
    font-style: normal;
  }

  .slap-reviews__card-author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid #e5e5e5;
  }

  .slap-reviews__card-avatar {
    width: 36px;
    height: 36px;
    background: #1a1a1a;
    color: #39FF14;
    font-family: 'Oswald', sans-serif;
    font-size: 16px;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .slap-reviews__card-info {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .slap-reviews__card-name {
    font-family: 'Oswald', sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #1a1a1a;
  }

  .slap-reviews__card-product {
    font-family: 'Space Mono', monospace;
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #a3a3a3;
  }

  .slap-reviews__card-verified {
    font-family: 'Space Mono', monospace;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #39FF14;
    background: #1a1a1a;
    padding: 3px 8px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media screen and (max-width: 989px) {
    .slap-reviews__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .slap-reviews__grid {
      grid-template-columns: 1fr;
    }

    .slap-reviews__heading {
      font-size: 36px;
    }
  }
</style>

{% schema %}
