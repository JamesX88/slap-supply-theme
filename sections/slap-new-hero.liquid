{% comment %}
  New Hero Section — Light Theme with Animated Typing
  Replaces the existing "PRINT IT. STICK IT. OWN IT." hero
{% endcomment %}

<section class="slap-new-hero" data-section-id="{{ section.id }}" data-section-type="slap-new-hero">
  {%- comment -%} Hero Content {%- endcomment -%}
  <div class="slap-new-hero__wrapper">
    {%- comment -%} Background Image {%- endcomment -%}
    <div class="slap-new-hero__bg">
      {%- if section.settings.hero_image != blank -%}
        {{ section.settings.hero_image | image_url: width: 1920 | image_tag: loading: 'eager', class: 'slap-new-hero__bg-img' }}
      {%- endif -%}
    </div>

    {%- comment -%} Content Grid {%- endcomment -%}
    <div class="slap-new-hero__content">
      <div class="slap-new-hero__text">
        {%- comment -%} Station Label {%- endcomment -%}
        <div class="slap-new-hero__label">
          <span class="slap-new-hero__label-line"></span>
          <span class="slap-new-hero__label-text">{{ section.settings.station_label | default: "STATION 01 — HERO" }}</span>
        </div>

        {%- comment -%} Main Headline with Animated Typing {%- endcomment -%}
        <h1 class="slap-new-hero__headline">
          YOUR <span class="slap-new-hero__typed" data-words='["BRAND", "EVENT", "APP", "BUSINESS", "PRODUCT", "BOXES", "WINDOWS"]'></span>,<br>
          BUT <span class="slap-new-hero__highlight">STICKIER.</span>
        </h1>

        {%- comment -%} Subtext {%- endcomment -%}
        <p class="slap-new-hero__subtext">{{ section.settings.subtext | default: "(custom die-cut stickers, labels & adhesive prints)" }}</p>

        {%- comment -%} CTAs {%- endcomment -%}
        <div class="slap-new-hero__ctas">
          <a href="{{ section.settings.primary_cta_link }}" class="slap-new-hero__cta slap-new-hero__cta--primary">
            {{ section.settings.primary_cta_text | default: "LET'S SLAP →" }}
          </a>
          <a href="{{ section.settings.secondary_cta_link }}" class="slap-new-hero__cta slap-new-hero__cta--secondary">
            {{ section.settings.secondary_cta_text | default: "SHOW ME THE GOODS" }}
          </a>
        </div>
      </div>

      {%- comment -%} Right Side Image {%- endcomment -%}
      <div class="slap-new-hero__image">
        {%- if section.settings.collage_image != blank -%}
          {{ section.settings.collage_image | image_url: width: 800 | image_tag: loading: 'eager', class: 'slap-new-hero__collage' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "New Hero (Mockup)",
  "settings": [
    {
      "type": "text",
      "id": "station_label",
      "label": "Station Label",
      "default": "STATION 01 — HERO"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "(custom die-cut stickers, labels & adhesive prints)"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "collage_image",
      "label": "Sticker Collage Image"
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary CTA Text",
      "default": "LET'S SLAP →"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary CTA Link"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary CTA Text",
      "default": "SHOW ME THE GOODS"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary CTA Link"
    }
  ],
  "presets": [
    {
      "name": "New Hero (Mockup)"
    }
  ]
}
{% endschema %}
