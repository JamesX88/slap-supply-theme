{{ 'slap-supply-pressroom.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="slap-hiw-v2">
  <div class="page-width section-{{ section.id }}-padding">
    <!-- Section Header -->
    <div class="slap-hiw-v2__header">
      <div class="slap-hiw-v2__station-label">STATION 03 — PROCESS</div>
      <h3 class="slap-hiw-v2__heading">HOW IT WORKS</h3>
    </div>

    <!-- Steps Grid - bordered container with vertical dividers -->
    <div class="slap-hiw-v2__steps">
      {%- for block in section.blocks -%}
        <div class="slap-hiw-v2__step {% if forloop.last %}slap-hiw-v2__step--last{% endif %}" {{ block.shopify_attributes }}>
          <div class="slap-hiw-v2__step-number">
            {{ forloop.index | prepend: '0' | slice: -2, 2 }}
          </div>
          {%- if block.settings.icon_text != blank -%}
            <div class="slap-hiw-v2__step-icon">{{ block.settings.icon_text }}</div>
          {%- endif -%}
          <h4 class="slap-hiw-v2__step-title">{{ block.settings.title }}</h4>
          <p class="slap-hiw-v2__step-text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .slap-hiw-v2 {
    background-color: #FFFFFF;
    position: relative;
  }

  .slap-hiw-v2__header {
    text-align: left;
    margin-bottom: 3rem;
  }

  .slap-hiw-v2__station-label {
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #737373;
    margin-bottom: 0.8rem;
  }

  .slap-hiw-v2__heading {
    font-family: 'Oswald', sans-serif !important;
    font-size: 36px;
    font-weight: 900;
    text-transform: uppercase;
    line-height: 40px;
    letter-spacing: -0.9px;
    margin: 0;
    color: #1a1a1a;
  }

  /* Steps Layout - 4 columns, each card has its own border */
  .slap-hiw-v2__steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }

  .slap-hiw-v2__step {
    position: relative;
    padding: 32px;
    text-align: left;
    background: transparent;
    transition: all 0.3s ease;
    border: 1px solid #e5e5e5;
  }

  .slap-hiw-v2__step + .slap-hiw-v2__step {
    border-left: none;
  }

  .slap-hiw-v2__step--last {
  }

  .slap-hiw-v2__step:hover {
    background: #1a1a1a;
    color: #fff;
  }

  .slap-hiw-v2__step:hover .slap-hiw-v2__step-title {
    color: #fff;
  }

  .slap-hiw-v2__step:hover .slap-hiw-v2__step-text {
    color: rgba(255, 255, 255, 0.7);
  }

  .slap-hiw-v2__step-number {
    font-family: 'Oswald', sans-serif;
    font-size: 48px;
    font-weight: 900;
    color: #39FF14;
    line-height: 48px;
    margin-bottom: 1.5rem;
  }

  .slap-hiw-v2__step-icon {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    line-height: 1;
    opacity: 0.5;
  }

  .slap-hiw-v2__step-title {
    font-family: 'Oswald', sans-serif !important;
    font-size: 20px;
    font-weight: 700;
    text-transform: uppercase;
    margin: 0 0 0.8rem;
    letter-spacing: -0.5px;
    line-height: 28px;
    color: #1a1a1a;
  }

  .slap-hiw-v2__step-text {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    color: #737373;
    line-height: 22.75px;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .slap-hiw-v2__steps {
      grid-template-columns: repeat(2, 1fr);
    }

    .slap-hiw-v2__step + .slap-hiw-v2__step {
      border-left: 1px solid #e5e5e5;
    }

    .slap-hiw-v2__step:nth-child(2n+1) {
      border-left: 1px solid #e5e5e5;
    }
  }

  @media screen and (max-width: 749px) {
    .slap-hiw-v2__steps {
      grid-template-columns: 1fr;
    }

    .slap-hiw-v2__step {
      border: 1px solid #e5e5e5;
    }

    .slap-hiw-v2__step + .slap-hiw-v2__step {
      border-top: none;
    }
  }
</style>

{% schema %}
{
  "name": "SLAP How It Works",
  "tag": "section",
  "class": "section slap-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "label_text",
      "default": "THE PROCESS",
      "label": "Section Label"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "HOW IT WORKS",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "description",
      "default": "",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "icon_text",
          "default": "↑",
          "label": "Icon/Symbol"
        },
        {
          "type": "text",
          "id": "title",
          "default": "UPLOAD",
          "label": "Step Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "default": "Drop your artwork or design from scratch using our editor",
          "label": "Step Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SLAP How It Works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "icon_text": "↑",
            "title": "UPLOAD",
            "text": "Drop your artwork or design from scratch using our editor"
          }
        },
        {
          "type": "step",
          "settings": {
            "icon_text": "⚙",
            "title": "CONFIGURE",
            "text": "Choose size, material, finish, and quantity"
          }
        },
        {
          "type": "step",
          "settings": {
            "icon_text": "≡",
            "title": "PROOF",
            "text": "Review your digital proof — adjust until it's perfect"
          }
        },
        {
          "type": "step",
          "settings": {
            "icon_text": "📦",
            "title": "SHIP",
            "text": "We print, cut, and ship in as fast as 3 business days"
          }
        }
      ]
    }
  ]
}
{% endschema %}
