{{ 'slap-supply-pressroom.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="slap-how-it-works color-{{ section.settings.color_scheme }}">
  <div class="page-width section-{{ section.id }}-padding">
    <!-- Section Header -->
    <div class="slap-hiw__header">
      <div class="slap-hiw__label slap-label">{{ section.settings.label_text }}</div>
      <h2 class="slap-hiw__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.description != blank -%}
        <p class="slap-hiw__description">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    <!-- Steps Grid -->
    <div class="slap-hiw__steps">
      {%- for block in section.blocks -%}
        <div class="slap-hiw__step" {{ block.shopify_attributes }}>
          <!-- Step Number -->
          <div class="slap-hiw__step-number">
            <span class="slap-hiw__step-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          </div>

          <!-- Step Content -->
          <div class="slap-hiw__step-content">
            {%- if block.settings.icon_text != blank -%}
              <div class="slap-hiw__step-icon">{{ block.settings.icon_text }}</div>
            {%- endif -%}
            <h3 class="slap-hiw__step-title">{{ block.settings.title }}</h3>
            <p class="slap-hiw__step-text">{{ block.settings.text }}</p>
          </div>

          <!-- Connector Line (not on last item) -->
          {%- unless forloop.last -%}
            <div class="slap-hiw__connector">
              <div class="slap-hiw__connector-line"></div>
              <div class="slap-hiw__connector-arrow">→</div>
            </div>
          {%- endunless -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="slap-hiw__cta">
        <a href="{{ section.settings.button_link }}" class="button button--primary slap-hiw__btn">
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>

  <!-- Caution Tape Divider -->
  <div class="section-divider-caution"></div>
</div>

<style>
  .slap-how-it-works {
    background-color: var(--slap-off-white);
    position: relative;
  }

  .slap-how-it-works.color-scheme-3,
  .slap-how-it-works.color-scheme-5 {
    background-color: var(--slap-black);
  }

  .slap-hiw__header {
    text-align: center;
    margin-bottom: 4rem;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .slap-hiw__label {
    margin-bottom: 1rem;
  }

  .slap-hiw__heading {
    font-family: 'Oswald', sans-serif !important;
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1;
    margin: 0 0 1rem;
  }

  .slap-hiw__description {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.1rem;
    color: var(--slap-mid-gray);
    line-height: 1.5;
    margin: 0;
  }

  /* Steps Layout */
  .slap-hiw__steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0;
    position: relative;
  }

  .slap-hiw__step {
    position: relative;
    text-align: center;
    padding: 2rem 1.5rem;
  }

  .slap-hiw__step-number {
    margin-bottom: 1.5rem;
  }

  .slap-hiw__step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border: 3px solid var(--slap-black);
    background: var(--slap-neon-green);
    color: var(--slap-black);
    font-family: 'Oswald', sans-serif;
    font-size: 1.8rem;
    font-weight: 700;
    box-shadow: 3px 3px 0 var(--slap-black);
  }

  .slap-hiw__step-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1;
  }

  .slap-hiw__step-title {
    font-family: 'Oswald', sans-serif !important;
    font-size: 1.4rem;
    font-weight: 700;
    text-transform: uppercase;
    margin: 0 0 0.8rem;
    letter-spacing: 0.03em;
  }

  .slap-hiw__step-text {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.95rem;
    color: var(--slap-mid-gray);
    line-height: 1.5;
    margin: 0;
  }

  /* Connector */
  .slap-hiw__connector {
    position: absolute;
    right: -1.5rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: flex;
    align-items: center;
  }

  .slap-hiw__connector-arrow {
    font-family: 'Oswald', sans-serif;
    font-size: 1.5rem;
    color: var(--slap-neon-green);
    font-weight: 700;
    background: var(--slap-off-white);
    padding: 0 0.3rem;
  }

  .slap-hiw__connector-line {
    display: none;
  }

  /* CTA */
  .slap-hiw__cta {
    text-align: center;
    margin-top: 3rem;
  }

  .slap-hiw__btn {
    padding: 1.2rem 3rem !important;
    font-size: 1.1rem !important;
  }

  @media screen and (max-width: 749px) {
    .slap-hiw__steps {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .slap-hiw__step {
      display: flex;
      align-items: flex-start;
      text-align: left;
      gap: 1.5rem;
      padding: 1.5rem 0;
      border-bottom: 2px dashed var(--slap-light-gray);
    }

    .slap-hiw__step:last-child {
      border-bottom: none;
    }

    .slap-hiw__step-number {
      margin-bottom: 0;
      flex-shrink: 0;
    }

    .slap-hiw__step-num {
      width: 48px;
      height: 48px;
      font-size: 1.4rem;
    }

    .slap-hiw__connector {
      display: none;
    }

    .slap-hiw__step-icon {
      font-size: 1.8rem;
      margin-bottom: 0.5rem;
    }
  }
</style>

{% schema %}
{
  "name": "SLAP How It Works",
  "tag": "section",
  "class": "section slap-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "label_text",
      "default": "THE PROCESS",
      "label": "Section Label"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "HOW IT WORKS",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "description",
      "default": "From concept to delivery in 4 simple steps. No BS, no hidden fees.",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "GET STARTED NOW",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "icon_text",
          "default": "📤",
          "label": "Icon/Emoji"
        },
        {
          "type": "text",
          "id": "title",
          "default": "UPLOAD YOUR DESIGN",
          "label": "Step Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "default": "Upload your artwork or use our design tools to create something fresh.",
          "label": "Step Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SLAP How It Works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "icon_text": "📤",
            "title": "UPLOAD YOUR DESIGN",
            "text": "Upload your artwork or let us know what you need. We accept all major file formats."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon_text": "⚙️",
            "title": "CHOOSE YOUR SPECS",
            "text": "Pick your material, size, finish, and quantity. We'll handle the rest."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon_text": "🖨️",
            "title": "WE PRINT IT",
            "text": "Your order hits our press room floor. Premium materials, precision cuts."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon_text": "📦",
            "title": "FAST DELIVERY",
            "text": "Shipped to your door in 3-5 business days. Free shipping on orders over $50."
          }
        }
      ]
    }
  ]
}
{% endschema %}
