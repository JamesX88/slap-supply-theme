{{ 'slap-supply-pressroom.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="slap-categories-v2">
  <div class="page-width section-{{ section.id }}-padding">
    <!-- Section Header -->
    <div class="slap-categories-v2__header">
      <div class="slap-categories-v2__station-label">STATION 02 — PRODUCTS</div>
      <h3 class="slap-categories-v2__heading">WHAT WE MAKE</h3>
    </div>

    <!-- Category Grid -->
    <div class="slap-categories-v2__grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="slap-cat-card" {{ block.shopify_attributes }}>
          <div class="slap-cat-card__image-wrapper">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag:
                  class: 'slap-cat-card__image',
                  sizes: '(min-width: 750px) 25vw, 50vw',
                  widths: '200, 400, 600, 800'
              }}
            {%- else -%}
              <div class="slap-cat-card__placeholder">
                <img src="https://images.unsplash.com/photo-1635048424329-a9bfb146d7aa?w=400&q=80" alt="{{ block.settings.title }}" class="slap-cat-card__image" loading="lazy">
              </div>
            {%- endif -%}
            {%- if block.settings.badge_text != blank -%}
              <div class="slap-cat-card__badge">{{ block.settings.badge_text }}</div>
            {%- endif -%}
          </div>
          <div class="slap-cat-card__content">
            <h4 class="slap-cat-card__title">{{ block.settings.title }}</h4>
            {%- if block.settings.subtitle != blank -%}
              <p class="slap-cat-card__subtitle">{{ block.settings.subtitle }}</p>
            {%- endif -%}
            <span class="slap-cat-card__configure">CONFIGURE <span class="slap-cat-card__configure-arrow">›</span></span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .slap-categories-v2 {
    background-color: #E8E4DF;
  }

  .slap-categories-v2__header {
    text-align: left;
    margin-bottom: 2.5rem;
  }

  .slap-categories-v2__station-label {
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #737373;
    margin-bottom: 0.8rem;
  }

  .slap-categories-v2__heading {
    font-family: 'Oswald', sans-serif !important;
    font-size: 36px;
    font-weight: 900;
    text-transform: uppercase;
    line-height: 40px;
    letter-spacing: -0.9px;
    margin: 0;
    color: #1a1a1a;
  }

  /* Category Grid */
  .slap-categories-v2__grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(4, 1fr);
  }

  /* Category Card */
  .slap-cat-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border: 1px solid #d4d4d4;
    background: #fff;
    transition: all 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    overflow: hidden;
  }

  .slap-cat-card:hover {
    box-shadow: 4px 4px 0 #1a1a1a;
    transform: translate(-2px, -2px);
    text-decoration: none;
    color: inherit;
  }

  .slap-cat-card__image-wrapper {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4/3;
    border-bottom: 1px solid #d4d4d4;
  }

  .slap-cat-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
    display: block;
  }

  .slap-cat-card:hover .slap-cat-card__image {
    transform: scale(1.05);
  }

  .slap-cat-card__placeholder {
    width: 100%;
    height: 100%;
  }

  .slap-cat-card__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    font-family: 'Space Mono', monospace;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    background: #1a1a1a;
    padding: 4px 8px;
    z-index: 2;
  }

  .slap-cat-card__content {
    padding: 1rem 1.2rem 1.2rem;
  }

  .slap-cat-card__title {
    font-family: 'Oswald', sans-serif !important;
    font-size: 18px;
    font-weight: 700;
    text-transform: uppercase;
    margin: 0 0 0.3rem;
    line-height: 28px;
    letter-spacing: -0.45px;
    color: #1a1a1a;
  }

  .slap-cat-card__subtitle {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 12px;
    color: #737373;
    margin: 0 0 0.8rem;
    line-height: 16px;
  }

  .slap-cat-card__configure {
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    color: #1a1a1a;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .slap-cat-card__configure-arrow {
    font-size: 1.1em;
    transition: transform 0.2s ease;
  }

  .slap-cat-card:hover .slap-cat-card__configure-arrow {
    transform: translateX(3px);
  }

  @media screen and (max-width: 989px) {
    .slap-categories-v2__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .slap-categories-v2__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .slap-cat-card__content {
      padding: 0.8rem;
    }

    .slap-cat-card__title {
      font-size: 16px;
    }
  }
</style>

{% schema %}
{
  "name": "SLAP Categories",
  "tag": "section",
  "class": "section slap-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "label_text",
      "default": "WHAT WE MAKE",
      "label": "Section Label"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "PRODUCT CATEGORIES",
      "label": "Heading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "default": "CUSTOM STICKERS",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "default": "Die-cut, kiss-cut, vinyl, holographic",
          "label": "Subtitle"
        },
        {
          "type": "text",
          "id": "badge_text",
          "default": "BEST SELLER",
          "label": "Badge Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SLAP Categories",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "CUSTOM STICKERS",
            "subtitle": "Die-cut, kiss-cut, vinyl, holographic",
            "badge_text": "BEST SELLER"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "PRODUCT LABELS",
            "subtitle": "Rolls, sheets, waterproof, freezer-safe",
            "badge_text": "B2B READY"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "ADHESIVE PRINTS",
            "subtitle": "Wall graphics, floor decals, window clings",
            "badge_text": "LARGE FORMAT"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "CUSTOM PRINTS",
            "subtitle": "Art prints, posters, packaging inserts",
            "badge_text": "NEW"
          }
        }
      ]
    }
  ]
}
{% endschema %}
