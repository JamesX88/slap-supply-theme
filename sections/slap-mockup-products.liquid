{% comment %}
  SLAP Supply Mockup Products Section
{% endcomment %}

<style>
  .slap-mockup-products {
    background: #0a0a0a;
    padding: 6rem 2rem;
  }

  .slap-mockup-products__container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .slap-mockup-products__header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .slap-mockup-products__header p {
    font-family: 'Space Grotesk', sans-serif;
    color: #39FF14;
    font-size: 0.875rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .slap-mockup-products__header h2 {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    color: white;
    text-transform: uppercase;
    margin: 0;
  }

  .slap-mockup-products__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .slap-mockup-product-card {
    background: #1a1a1a;
    border: 2px solid #2a2a2a;
    padding: 2rem;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .slap-mockup-product-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #39FF14, #FFE600);
  }

  .slap-mockup-product-card:hover {
    transform: translateY(-8px);
    border-color: #39FF14;
  }

  .slap-mockup-product-card__tag {
    display: inline-block;
    font-family: 'Oswald', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    background: #39FF14;
    color: #0a0a0a;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1rem;
  }

  .slap-mockup-product-card h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1.75rem;
    font-weight: 700;
    color: white;
    text-transform: uppercase;
    margin: 0 0 0.5rem 0;
  }

  .slap-mockup-product-card p {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.95rem;
    color: #888;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 768px) {
    .slap-mockup-products {
      padding: 4rem 1rem;
    }

    .slap-mockup-products__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<section class="slap-mockup-products">
  <div class="slap-mockup-products__container">
    <div class="slap-mockup-products__header">
      <p>—— STATION 02 — PRODUCTS</p>
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <div class="slap-mockup-products__grid">
      {% for block in section.blocks %}
        <div class="slap-mockup-product-card">
          <span class="slap-mockup-product-card__tag">{{ block.settings.tag }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Mockup Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "WHAT WE SLAP"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product Card",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "BEST SELLER"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Product Title",
          "default": "CUSTOM STICKERS"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Die-cut, kiss-cut, vinyl, holographic"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mockup Products",
      "blocks": [
        {
          "type": "product",
          "settings": {
            "tag": "BEST SELLER",
            "title": "CUSTOM STICKERS",
            "description": "Die-cut, kiss-cut, vinyl, holographic"
          }
        },
        {
          "type": "product",
          "settings": {
            "tag": "B2B READY",
            "title": "PRODUCT LABELS",
            "description": "Rolls, sheets, waterproof, freezer-safe"
          }
        },
        {
          "type": "product",
          "settings": {
            "tag": "NEW",
            "title": "ADHESIVE PRINTS",
            "description": "Posters, wall graphics, floor decals"
          }
        }
      ]
    }
  ]
}
{% endschema %}
