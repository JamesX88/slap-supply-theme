{% comment %}
  Scrolling Marquee Banner — Customizable
  Can be toggled on/off, text and speed adjustable
{% endcomment %}

<section class="slap-scrolling-marquee" data-section-id="{{ section.id }}" data-section-type="slap-scrolling-marquee">
  <div class="slap-scrolling-marquee__track" data-speed="{{ section.settings.scroll_speed }}">
    <span>{{ section.settings.marquee_text }}</span>
    <span>{{ section.settings.marquee_text }}</span>
  </div>
</section>

<style>
.slap-scrolling-marquee {
  background: #39FF14;
  border-top: 4px solid #000;
  border-bottom: 4px solid #000;
  padding: 12px 0;
  overflow: hidden;
  position: relative;
}

.slap-scrolling-marquee__track {
  display: flex;
  gap: 0;
  white-space: nowrap;
  animation: marquee-scroll var(--marquee-speed, 20s) linear infinite;
}

.slap-scrolling-marquee__track span {
  font-family: 'Oswald', sans-serif;
  font-weight: 700;
  font-size: 14px;
  letter-spacing: 0.15em;
  color: #000;
  padding-right: 40px;
}

@keyframes marquee-scroll {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}

/* Speed control via custom property */
.slap-scrolling-marquee__track[data-speed="slow"] {
  --marquee-speed: 40s;
}

.slap-scrolling-marquee__track[data-speed="medium"] {
  --marquee-speed: 20s;
}

.slap-scrolling-marquee__track[data-speed="fast"] {
  --marquee-speed: 10s;
}
</style>

{% schema %}
{
  "name": "Scrolling Marquee",
  "settings": [
    {
      "type": "textarea",
      "id": "marquee_text",
      "label": "Marquee Text",
      "default": "FREE SHIPPING ON ORDERS $75+ /// BULK PRICING AVAILABLE /// 3-DAY TURNAROUND /// 100% SATISFACTION GUARANTEED /// NO STICKER REGRETS /// MADE BY PRINT NERDS /// SLAP RESPONSIBLY /// "
    },
    {
      "type": "select",
      "id": "scroll_speed",
      "label": "Scroll Speed",
      "options": [
        {
          "value": "slow",
          "label": "Slow (40s)"
        },
        {
          "value": "medium",
          "label": "Medium (20s)"
        },
        {
          "value": "fast",
          "label": "Fast (10s)"
        }
      ],
      "default": "medium"
    }
  ],
  "presets": [
    {
      "name": "Scrolling Marquee"
    }
  ]
}
{% endschema %}
