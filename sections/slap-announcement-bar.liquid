{{ 'slap-supply-pressroom.css' | asset_url | stylesheet_tag }}

<div class="slap-announcement-bar">
  <div class="slap-announcement-bar__track">
    {%- for i in (1..8) -%}
      <span class="slap-announcement-bar__item">FREE SHIPPING ON ORDERS $75+</span>
      <span class="slap-announcement-bar__sep">&nbsp;&nbsp;&nbsp;///&nbsp;&nbsp;&nbsp;</span>
      <span class="slap-announcement-bar__item">BULK PRICING AVAILABLE</span>
      <span class="slap-announcement-bar__sep">&nbsp;&nbsp;&nbsp;///&nbsp;&nbsp;&nbsp;</span>
      <span class="slap-announcement-bar__item">3-DAY TURNAROUND</span>
      <span class="slap-announcement-bar__sep">&nbsp;&nbsp;&nbsp;///&nbsp;&nbsp;&nbsp;</span>
    {%- endfor -%}
  </div>
</div>

<style>
  .slap-announcement-bar {
    background-color: #1a1a1a;
    overflow: hidden;
    white-space: nowrap;
    padding: 8px 0;
    border-bottom: none;
  }

  .slap-announcement-bar__track {
    display: inline-flex;
    animation: slap-announce-scroll 30s linear infinite;
  }

  .slap-announcement-bar__item {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.55px;
    text-transform: uppercase;
    color: #39FF14;
    flex-shrink: 0;
  }

  .slap-announcement-bar__sep {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    color: #39FF14;
    flex-shrink: 0;
  }

  @keyframes slap-announce-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>

{% schema %}
{
  "name": "SLAP Announcement Bar",
  "tag": "section",
  "class": "section slap-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    }
  ],
  "presets": [
    {
      "name": "SLAP Announcement Bar"
    }
  ]
}
{% endschema %}
