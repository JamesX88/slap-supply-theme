{{ 'slap-supply-pressroom.css' | asset_url | stylesheet_tag }}
{{ 'slap-text-sizing-fix.css' | asset_url | stylesheet_tag }}

<div class="slap-caution-divider">
  <div class="slap-caution-divider__tape">
    <div class="slap-caution-divider__text-overlay">
      <span>{{ section.settings.overlay_text }}</span>
    </div>
  </div>
</div>

<style>
  .slap-caution-divider {
    position: relative;
    overflow: hidden;
  }

  .slap-caution-divider__tape {
    width: 100%;
    height: 32px;
    background: repeating-linear-gradient(
      135deg,
      #39FF14,
      #39FF14 20px,
      #1a1a1a 20px,
      #1a1a1a 40px
    );
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .slap-caution-divider__text-overlay {
    position: relative;
    z-index: 2;
  }

  .slap-caution-divider__text-overlay span {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: #fff;
    background: #1a1a1a;
    padding: 6px 20px;
    display: inline-block;
  }
</style>

{% schema %}
{
  "name": "SLAP Caution Divider",
  "tag": "section",
  "class": "section slap-section slap-marquee-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "overlay_text",
      "default": "PRODUCT CATEGORIES",
      "label": "Overlay Text"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    }
  ],
  "presets": [
    {
      "name": "SLAP Caution Divider"
    }
  ]
}
{% endschema %}
