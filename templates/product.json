{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "sku": {
          "type": "sku",
          "settings": {
            "text_style": "uppercase"
          }
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "description": {
          "type": "description"
        },
        "collapsible_material": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Material & Specs",
            "icon": "leather",
            "content": "<p>Our stickers are printed on premium vinyl with a strong adhesive backing. Waterproof, UV-resistant, and built to last outdoors or indoors.</p>",
            "page": ""
          }
        },
        "collapsible_sizing": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Sizing Guide",
            "icon": "ruler",
            "content": "<p>Available in standard sizes from 2\" to 12\". Custom sizes available for bulk orders. Contact us for enterprise pricing.</p>",
            "page": ""
          }
        },
        "collapsible_shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & Turnaround",
            "icon": "truck",
            "content": "<p>Standard orders ship within 3-5 business days. Rush orders available. Free shipping on orders over $50.</p>",
            "page": ""
          }
        },
        "collapsible_bulk": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Bulk & B2B Orders",
            "icon": "clipboard",
            "content": "<p>Need 1,000+ units? We offer volume discounts and dedicated account management for business customers. Get in touch for a custom quote.</p>",
            "page": ""
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        },
        "social_proof": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"slap-social-proof\">\n  <span class=\"slap-social-proof__stars\">\u2605\u2605\u2605\u2605\u2605</span>\n  <span class=\"slap-social-proof__text\">4.9/5</span>\n  <span class=\"slap-social-proof__count\">\u2022 2,400+ orders shipped</span>\n</div>"
          }
        },
        "urgency": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"slap-urgency\">\n  <span class=\"slap-urgency__icon\">\u26a1</span>\n  <span>Order today \u2014 ships within 3-5 business days</span>\n</div>"
          }
        },
        "value_props": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"slap-value-props\">\n  <div class=\"slap-value-props__item\">\n    <span class=\"slap-value-props__icon\">\ud83d\ude9a</span>\n    <span>Free shipping $50+</span>\n  </div>\n  <div class=\"slap-value-props__item\">\n    <span class=\"slap-value-props__icon\">\u2600\ufe0f</span>\n    <span>Weatherproof &amp; UV-resistant</span>\n  </div>\n  <div class=\"slap-value-props__item\">\n    <span class=\"slap-value-props__icon\">\ud83c\udfed</span>\n    <span>Made in-house, USA</span>\n  </div>\n  <div class=\"slap-value-props__item\">\n    <span class=\"slap-value-props__icon\">\ud83d\udce6</span>\n    <span>Bulk discounts available</span>\n  </div>\n</div>"
          }
        },
        "guarantee": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"slap-guarantee\">\n  <span class=\"slap-guarantee__icon\">\ud83d\udee1\ufe0f</span>\n  <div class=\"slap-guarantee__text\">\n    <div class=\"slap-guarantee__title\">100% Satisfaction Guarantee</div>\n    <div class=\"slap-guarantee__desc\">Not happy with your order? We'll reprint or refund \u2014 no questions asked.</div>\n  </div>\n</div>"
          }
        },
        "payment_trust": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"slap-payment-icons\">\n  <div class=\"slap-payment-icons__label\">Secure checkout with</div>\n  <div class=\"slap-payment-icons__icon\">VISA</div>\n  <div class=\"slap-payment-icons__icon\">MC</div>\n  <div class=\"slap-payment-icons__icon\">AMEX</div>\n  <div class=\"slap-payment-icons__icon\">SHOP</div>\n  <div class=\"slap-payment-icons__icon\">PYPL</div>\n  <div class=\"slap-payment-icons__icon\">\ud83d\udd12</div>\n</div>"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "social_proof",
        "price",
        "urgency",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "value_props",
        "guarantee",
        "payment_trust",
        "description",
        "collapsible_material",
        "collapsible_sizing",
        "collapsible_shipping",
        "collapsible_bulk",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "gallery_layout": "thumbnail",
        "media_size": "medium",
        "media_fit": "contain",
        "constrain_to_viewport": true,
        "mobile_thumbnails": "show",
        "media_position": "left",
        "image_zoom": "hover",
        "hide_variants": true,
        "enable_video_looping": false,
        "color_scheme": "scheme-1",
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "YOU MIGHT ALSO NEED",
        "heading_size": "h2",
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 40,
        "padding_bottom": 40
      }
    }
  },
  "order": [
    "main",
    "related-products"
  ]
}
