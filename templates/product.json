{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "sku": {
          "type": "sku",
          "settings": {
            "text_style": "uppercase"
          }
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "description": {
          "type": "description"
        },
        "collapsible_material": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Material & Specs",
            "icon": "leather",
            "content": "<p>Our stickers are printed on premium vinyl with a strong adhesive backing. Waterproof, UV-resistant, and built to last outdoors or indoors.</p>",
            "page": ""
          }
        },
        "collapsible_sizing": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Sizing Guide",
            "icon": "ruler",
            "content": "<p>Available in standard sizes from 2\" to 12\". Custom sizes available for bulk orders. Contact us for enterprise pricing.</p>",
            "page": ""
          }
        },
        "collapsible_shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & Turnaround",
            "icon": "truck",
            "content": "<p>Standard orders ship within 3-5 business days. Rush orders available. Free shipping on orders over $50.</p>",
            "page": ""
          }
        },
        "collapsible_bulk": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Bulk & B2B Orders",
            "icon": "clipboard",
            "content": "<p>Need 1,000+ units? We offer volume discounts and dedicated account management for business customers. Get in touch for a custom quote.</p>",
            "page": ""
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "sku",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "collapsible_material",
        "collapsible_sizing",
        "collapsible_shipping",
        "collapsible_bulk",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "gallery_layout": "thumbnail",
        "media_size": "medium",
        "media_fit": "contain",
        "constrain_to_viewport": true,
        "mobile_thumbnails": "show",
        "media_position": "left",
        "image_zoom": "hover",
        "hide_variants": true,
        "enable_video_looping": false,
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "YOU MIGHT ALSO NEED",
        "heading_size": "h2",
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 40,
        "padding_bottom": 40
      }
    }
  },
  "order": [
    "main",
    "related-products"
  ]
}
